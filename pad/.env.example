# ---------------------------------------------------------------- pad (server)
PORT=3001
PAD_TOKEN=change-me-to-a-long-random-string

# Resend (sending + inbound). Server-side only, never expose to the browser.
RESEND_API_KEY=re_xxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx

# Open + click tracking live ON THE DOMAIN in Resend (enable open/click tracking
# and set a tracking subdomain there), and the webhook must subscribe to
# email.opened + email.clicked — otherwise the pad receives nothing and the
# Tracking tab honestly reads zeros. This variable only names the host in the UI;
# it defaults to analytics.<first PAD_DOMAINS entry>, which is how both brands on
# this Resend account are set up. Override it only for a different subdomain.
# RESEND_TRACKING_DOMAIN=analytics.example.com

# ---------------------------------------------------------------- branding
# All of this is surfaced through GET /api/config — no HTML editing needed to
# re-badge the app for another project.
BRAND_NAME=NewsletterFIT
FROM_EMAIL=ian@newsletterfit.com
PUBLIC_BASE_URL=https://newsletterfit.com

# Mail from OTHER brands sharing the same Resend account is filtered out of
# Sent/Received. Comma-separate several domains. Leave EMPTY to show everything
# (which is what a single-brand Resend account should do).
PAD_DOMAINS=newsletterfit.com

# ---------------------------------------------------------------- leads engine
# The leads engine (leads/) is a separate process on an internal port, proxied
# by the pad at /api/crm/*. One token unlocks both surfaces.
CRM_PORT=3002
CRM_HOST=127.0.0.1
PAD_URL=http://127.0.0.1:3001
DATA_DIR=./leads/data
SERVICE_NAME=leads
# Optional overrides (otherwise config.json / defaults are used):
# LEAD_STAGES=[{"key":"leads","label":"Leads","color":"#64748b"}]
# LEAD_DUE_DAYS={"first_email":3,"follow_up_1":4,"follow_up_2":7}
# LEADPAD_CONFIG=/path/to/config.json
# PAD_ENV=/path/to/pad.env

# ---------------------------------------------------------------- outreach links
# Send-time link internalization (NewsletterFIT-specific; see LEADPAD.md).
NEWSLETTERFIT_API=http://127.0.0.1:3000/api/v1
ATTRIBUTION_STORE=/home/boxed/newsletterfit/attribution/attribution.json
