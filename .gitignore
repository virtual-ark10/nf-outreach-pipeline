# Runtime state is deliberately versioned in this repo — it is the only off-box
# archive of the CRM and the mail log (Resend only keeps email for 30 days).
# So do NOT add data/ or lead data to this file.
#
# Secrets, logs, database journals and tooling noise are excluded.

# --- secrets (never commit) ---
.env
.env.local
*.env.bak*
**/.env

# --- logs ---
*.log

# --- sqlite journals (the .db itself IS versioned; these are per-process scratch) ---
*-wal
*-shm

# --- scratch / migration artefacts ---
*.bak-*
*.pre-import
*.pre-token-fix
*.DS_Store
attic/

# --- tooling noise ---
node_modules/
__pycache__/
*.pyc

# VACUUM INTO snapshots taken before CRM writes: data, not source
pad/snapshots/

# Daily send volume: one number, editable without touching the gate.
data/send-cap.txt

# Provider-response cache for scripts/fill_contact_names.py: re-derivable at $0, so not
# archive material like data/. The CRM, the mail log and the send cap stay versioned.
data/name-cache/

# Employee-count lookups behind the off-ICP filter (scripts/icp_fit.py): re-derivable
# provider responses, same reasoning as data/name-cache.
data/icp-size-cache.json
